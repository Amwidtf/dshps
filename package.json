{
  "name": "dshps",
  "version": "0.2.0",
  "private": true,
  "description": "DSH plugin stack (dshp-*): balance/quota sidebar panel, network proxy routing with audit monitor, model sign-in, extended workflows, and a shared floating UI. One bundle, shared Web client.",
  "license": "MIT",
  "author": "dshps contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amwidtf/dshps.git"
  },
  "homepage": "https://github.com/Amwidtf/dshps#readme",
  "bugs": {
    "url": "https://github.com/Amwidtf/dshps/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "quota",
    "balance"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./plugins/dshp-quota": "./plugins/dshp-quota/host.js",
    "./plugins/dshp-quota/locale/*.json": "./plugins/dshp-quota/locale/*.json",
    "./plugins/dshp-quota/icon": "./plugins/dshp-quota/icon.svg",
    "./plugins/dshp-net": "./plugins/dshp-net/host.js",
    "./plugins/dshp-net/locale/*.json": "./plugins/dshp-net/locale/*.json",
    "./plugins/dshp-net/icon": "./plugins/dshp-net/icon.svg",
    "./plugins/dshp-models": "./plugins/dshp-models/host.js",
    "./plugins/dshp-models/locale/*.json": "./plugins/dshp-models/locale/*.json",
    "./plugins/dshp-models/icon": "./plugins/dshp-models/icon.svg",
    "./plugins/dshp-workflow": "./plugins/dshp-workflow/host.js",
    "./plugins/dshp-workflow/locale/*.json": "./plugins/dshp-workflow/locale/*.json",
    "./plugins/dshp-workflow/icon": "./plugins/dshp-workflow/icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "plugins/**/*"
  ],
  "scripts": {
    "test": "node tools/test-host.mjs && node tools/test-workflow.mjs && node tools/test-client.mjs",
    "check": "node --check index.js && node --check client.js && node --check plugins/dshp-quota/host.js && node --check plugins/dshp-net/host.js && node --check plugins/dshp-models/host.js && node --check plugins/dshp-workflow/host.js && node --check plugins/dshp-workflow/lib/meta.js && node --check plugins/dshp-workflow/lib/store.js && node --check plugins/dshp-workflow/lib/runtime.js && node --check tools/test-workflow.mjs",
    "hygiene": "node tools/check-repo.mjs",
    "docs:check": "node tools/check-docs.mjs",
    "setup:test-deps": "node tools/setup-test-deps.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
